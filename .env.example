# Application
APP_ENV=development
LOG_LEVEL=INFO

# LLM provider: openrouter (default) | ollama (local, optional)
LLM_PROVIDER=openrouter

# Database (host port 5433 -> container port 5432; 5432 is reserved by a native PostgreSQL service)
DATABASE_URL=postgresql+asyncpg://evalyx:evalyx@localhost:5433/evalyx

# Redis
REDIS_URL=redis://localhost:6379/0

# Security — generate a real key with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
EVALYX_SECRET_KEY=

# Application credential encryption (Phase 15). urlsafe base64 of a 32-byte
# AES-256-GCM key; REQUIRED when APP_ENV=production, optional in development
# until a credential is actually stored. Generate one with:
#   uv run python -c "from evalyx.core.encryption import generate_encryption_key; print(generate_encryption_key())"
EVALYX_ENCRYPTION_KEY=

# Clerk authentication (Phase 14). Clerk owns identity + organizations.
# Set AUTH_REQUIRED=0 only for local development without Clerk.
AUTH_REQUIRED=1
# Clerk Backend API key (sk_...) — server-side secret, never exposed.
CLERK_SECRET_KEY=
# Clerk instance JWKS URL (public keys; used for local token verification):
# https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Optional: comma-separated acceptable origins (authorized parties) for
# Clerk tokens; leave empty to disable the check.
CLERK_AUTHORIZED_PARTIES=

# OpenRouter
OPENROUTER_API_KEY=

# Free model used for agent experiments
EVALYX_AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Free model used for LLM evaluation
EVALYX_JUDGE_MODEL=minimax/minimax-m3:free

# Optional local Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Application-under-test target for the MLGPT reference demo (see README
# "Evalyx × MLGPT reference demo"). Only the worker uses this; MLGPT itself
# runs in its own repository. No credentials belong here — the demo target
# is an unauthenticated local HTTP endpoint.
MLGPT_BASE_URL=http://127.0.0.1:8001

# Background worker (Celery). The broker and result backend are derived from
# REDIS_URL above — no separate URLs. Concurrency stays conservative because
# free OpenRouter models are rate-limited; each run executes its cases
# sequentially regardless of these settings.
WORKER_CONCURRENCY=2
# Bounded job-level retries (provider HTTP retries are separate and live in
# the LLM layer). Backoff grows exponentially and is capped.
WORKER_MAX_RETRIES=3
WORKER_RETRY_BACKOFF_SECONDS=10
WORKER_RETRY_MAX_BACKOFF_SECONDS=300
# Soft limit lets the task clean up; hard limit (must be larger) kills it.
WORKER_SOFT_TIME_LIMIT_SECONDS=3600
WORKER_HARD_TIME_LIMIT_SECONDS=3900
# How long Celery task results (operational metadata only) stay in Redis.
WORKER_RESULT_TTL_SECONDS=86400