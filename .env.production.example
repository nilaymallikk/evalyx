# Evalyx PRODUCTION environment template (Phase 17).
#
# Copy to `.env.production` (gitignored — NEVER commit the filled-in file):
#   cp .env.production.example .env.production
# Fill every empty value from your secret store. The production compose
# file refuses to start when a required value is missing (`:?` guards).
#
# Secret delivery: prefer environment injection or container secrets
# (Docker secrets, Vault, cloud secret manager -> env). Never bake secrets
# into images, compose files, READMEs, or CI logs.

APP_ENV=production
AUTH_REQUIRED=1
LOG_LEVEL=INFO

# --- PostgreSQL (private, persistent; never publicly exposed) ---
POSTGRES_USER=evalyx
POSTGRES_PASSWORD=
POSTGRES_DB=evalyx
POSTGRES_MAX_CONNECTIONS=100
# Async SQLAlchemy URL for the app (service name `postgres`, port 5432).
# Encode special characters in the password (URL-encode) before pasting.
DATABASE_URL=postgresql+asyncpg://evalyx:CHANGEME@postgres:5432/evalyx

# --- Redis (private broker/cache; NOT the source of truth) ---
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_APPENDONLY=no
REDIS_SAVE=
# Redis URL for the app + Celery (service name `redis`, port 6379).
# Format when a password is set: redis://:PASSWORD@redis:6379/0
REDIS_URL=redis://:CHANGEME@redis:6379/0

# --- Clerk PRODUCTION instance (never development keys) ---
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://<your-prod-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTIES=

# --- Evalyx secrets (generate fresh; store in your secret manager) ---
# python -c "import secrets; print(secrets.token_urlsafe(32))"
EVALYX_SECRET_KEY=
# Application-credential encryption key (urlsafe base64 of 32 bytes).
# Generate: uv run python -c "from evalyx.core.encryption import generate_encryption_key; print(generate_encryption_key())"
# WARNING: rotating/losing this key makes existing encrypted application
# credentials undecryptable. Back it up with the database.
EVALYX_ENCRYPTION_KEY=

# --- LLM provider (server-side only; never sent to clients) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
EVALYX_AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
EVALYX_JUDGE_MODEL=minimax/minimax-m3:free

# --- API tuning ---
API_WORKERS=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EVAL_PER_MINUTE=20
RATE_LIMIT_TEST_PER_MINUTE=10
MAX_CASES_PER_EVALUATION=500
# Empty = CORS disabled (correct for CLI/TUI/API clients). Otherwise a
# comma-separated list of explicit origins — never "*".
CORS_ALLOWED_ORIGINS=

# --- Worker tuning ---
WORKER_CONCURRENCY=2
WORKER_MAX_RETRIES=3
WORKER_SOFT_TIME_LIMIT_SECONDS=3600
WORKER_HARD_TIME_LIMIT_SECONDS=3900
WORKER_LOGLEVEL=INFO

# --- Resource limits (compose deploy.resources) ---
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=1G
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2G

# --- Reverse proxy ---
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_PATH=./deploy/tls/fullchain.pem
TLS_KEY_PATH=./deploy/tls/privkey.pem
